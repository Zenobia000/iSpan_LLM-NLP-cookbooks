# 複製為 .env 後填入金鑰：cp .env.example .env
# .env 已在 .gitignore，切勿提交真實金鑰。

# --- 模型預設（notebook 以 os.getenv 讀取，可在此集中切換）---
OPENAI_MODEL=gpt-5.4-mini

# --- LLM providers（多模型並陳）---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# google-genai 讀取 GEMINI_API_KEY 或 GOOGLE_API_KEY
GEMINI_API_KEY=...
GOOGLE_API_KEY=...
# 03-reasoning-thinking DeepSeek 章節（選用）
DEEPSEEK_API_KEY=sk-...

# --- 工具 / 檢索 ---
COHERE_API_KEY=...
JINA_API_KEY=jina_...
SERPER_API_KEY=...
TAVILY_API_KEY=tvly-...
# 07-pdf-parsing LlamaParse（選用）
LLAMA_CLOUD_API_KEY=llx-...

# --- 評估 / 觀測（選用）---
BRAINTRUST_API_KEY=sk-...

# --- LangSmith 追蹤（選用；2026 環境變數名為 LANGSMITH_*）---
# LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=prompt-engineering

# --- 向下相容（少數舊 notebook 仍讀小寫變數名，可與上方同值）---
# openai_api_key=...
# google_api_key=...
# langsmith_api_key=...
