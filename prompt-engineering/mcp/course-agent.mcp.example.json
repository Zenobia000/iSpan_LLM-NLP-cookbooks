{
  "mcpServers": {
    "course-local": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp>=1.27,<2",
        "python",
        "prompt-engineering/mcp/course_mcp_server.py"
      ]
    },
    "repo-github-readonly": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
