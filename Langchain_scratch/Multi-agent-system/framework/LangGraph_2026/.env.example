# Model selection: any provider supported by LangChain init_chat_model.
COURSE_MODEL=openai:gpt-4o-mini

# Provider key for COURSE_MODEL.
OPENAI_API_KEY=sk-...

# Optional real search. Without this, use --offline-search for class demos.
# TAVILY_API_KEY=tvly-...

# Optional tuning.
MAX_RESEARCH_UNITS=3
SEARCH_RESULTS_PER_QUERY=4
