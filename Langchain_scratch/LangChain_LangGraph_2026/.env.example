# =====================================================================
# 課程環境變數範本 — 複製成 .env 後填入你的金鑰
#   cp .env.example .env
# =====================================================================

# --- 選擇課程預設模型 (provider:name 格式) -------------------------
# 全部 notebook 透過 _shared/course_utils.py 的 get_model() 讀取此變數，
# 改這一行就能整套課程切換供應商，程式碼一字不動。
COURSE_MODEL=openai:gpt-4o-mini
# COURSE_MODEL=anthropic:claude-haiku-4-5
# COURSE_MODEL=ollama:llama3.1            # 本地，免金鑰

COURSE_EMBEDDINGS=openai:text-embedding-3-small
# COURSE_EMBEDDINGS=ollama:nomic-embed-text

# --- API 金鑰 (依你選的供應商填寫對應項) ---------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- LangSmith 可觀測性 (選用，第二冊 M07 會用到) ------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langchain-langgraph-2026
